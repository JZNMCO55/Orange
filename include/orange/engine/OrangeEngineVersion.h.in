#ifndef ORANGE_ENGINE_ORANGE_ENGINE_VERSION_H
#define ORANGE_ENGINE_ORANGE_ENGINE_VERSION_H

// ---------------------------------------------------------------------------
// 由 CMake 生成的版本宏。
//
// 由顶层 CMakeLists.txt 在 configure 时 configure_file 出来；唯一权威
// 来源是 `project(VERSION ...)` 参数。需要按 OrangeEngine 版本做条件
// 编译的消费者，应 include 本头并比较 `ORANGE_ENGINE_VERSION`——它
// 是一个紧凑整数 (major * 10000 + minor * 100 + patch)，可直接和形如
// `010203` 的数字面量比较（即 1.2.3）。
//
// 字符串形式是 `ORANGE_ENGINE_VERSION_STRING`（如 "0.1.0"）；单独字段
// 也对外暴露，避免有 SemVer 处理需求的工具去解析字符串。
// ---------------------------------------------------------------------------

#define ORANGE_ENGINE_VERSION_MAJOR @OrangeEngine_VERSION_MAJOR@
#define ORANGE_ENGINE_VERSION_MINOR @OrangeEngine_VERSION_MINOR@
#define ORANGE_ENGINE_VERSION_PATCH @OrangeEngine_VERSION_PATCH@

#define ORANGE_ENGINE_VERSION  \
    (ORANGE_ENGINE_VERSION_MAJOR * 10000 \
   + ORANGE_ENGINE_VERSION_MINOR * 100   \
   + ORANGE_ENGINE_VERSION_PATCH)

#define ORANGE_ENGINE_VERSION_STRING "@OrangeEngine_VERSION@"

#endif  // ORANGE_ENGINE_ORANGE_ENGINE_VERSION_H
