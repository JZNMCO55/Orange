@PACKAGE_INIT@

# OrangeEngine 的 package config —— 通过
# `find_package(OrangeEngine 0.1 CONFIG REQUIRED)` 被消费时执行。
#
# 引擎当前以 STATIC 库形式发布；STATIC 库会把 PUBLIC / PRIVATE 链入
# 的第三方都需要在消费者侧能定位到对应的 imported target，否则 link
# 阶段会在符号解析时失败。所以下面的 find_dependency 列表覆盖了
# 顶层 CMakeLists.txt 真实链接到的全部第三方，PUBLIC 与 PRIVATE 一
# 视同仁；将来切到 SHARED 后，PRIVATE 项可以从这里删掉。
#
# 链接策略与顶层一致——细节见 cmake/Dependencies.cmake。

include(CMakeFindDependencyMacro)

find_dependency(OrangeRender 0.1 CONFIG)
find_dependency(glm CONFIG)
find_dependency(EnTT 3.13 CONFIG)
find_dependency(nlohmann_json 3 CONFIG)
find_dependency(glfw3 CONFIG)
find_dependency(box2d CONFIG)

# spdlog 仍是可选——是否在 link 接口里出现取决于 build 时的 gate；
# 由顶层 CMakeLists.txt 在 configure_package_config_file 之前根据当
# 时状态填写。
set(_ORANGE_ENGINE_NEEDS_SPDLOG "@ORANGE_ENGINE_PUBLIC_HAS_SPDLOG@")
if (_ORANGE_ENGINE_NEEDS_SPDLOG)
    find_dependency(spdlog CONFIG)
endif ()

# 引入 install(EXPORT ...) 生成的 namespaced imported target
# `OrangeEngine::orange_engine`。
include("${CMAKE_CURRENT_LIST_DIR}/OrangeEngineTargets.cmake")

check_required_components(OrangeEngine)
