@PACKAGE_INIT@

# OrangeEngine 的 package config —— 通过
# `find_package(OrangeEngine 0.1 CONFIG REQUIRED)` 被消费时执行。
#
# 引擎当前以 STATIC 库形式发布；STATIC 库会把 PUBLIC / PRIVATE 链入
# 的第三方都需要在消费者侧能定位到对应的 imported target，否则 link
# 阶段会在符号解析时失败。所以下面的 find_dependency 列表覆盖了
# 顶层 CMakeLists.txt 真实链接到的全部第三方，PUBLIC 与 PRIVATE 一
# 视同仁；将来切到 SHARED 后，PRIVATE 项可以从这里删掉。
#
# 链接策略与顶层一致——细节见 cmake/Dependencies.cmake。

include(CMakeFindDependencyMacro)

find_dependency(OrangeRender 0.1 CONFIG)
find_dependency(glm CONFIG)
find_dependency(EnTT 3.13 CONFIG)
find_dependency(nlohmann_json 3 CONFIG)
find_dependency(glfw3 CONFIG)
find_dependency(box2d CONFIG)
# Vulkan：内置 imgui target（OrangeEngine::imgui）PRIVATE 链 Vulkan::Vulkan，
# STATIC 库下作为 LINK_ONLY 传播到消费者——必须能解析 Vulkan::Vulkan target。
# NO_PROTOTYPES 下 imgui 不真引用 vk 符号，但 CMake 要求该 imported target 存在。
find_dependency(Vulkan)

# spdlog 仍是可选——是否在 link 接口里出现取决于 build 时的 gate；
# 由顶层 CMakeLists.txt 在 configure_package_config_file 之前根据当
# 时状态填写。
set(_ORANGE_ENGINE_NEEDS_SPDLOG "@ORANGE_ENGINE_PUBLIC_HAS_SPDLOG@")
if (_ORANGE_ENGINE_NEEDS_SPDLOG)
    find_dependency(spdlog CONFIG)
endif ()

# 引入 install(EXPORT ...) 生成的 namespaced imported target
# `OrangeEngine::orange_engine`（+ PUBLIC 依赖 OrangeEngine::orange_engine_imgui）。
include("${CMAKE_CURRENT_LIST_DIR}/OrangeEngineTargets.cmake")

# Build-tree 的 `OrangeEngine::imgui` 短别名（顶层 CMakeLists.txt
# `add_library(... ALIAS)` 创建）**不通过 install(EXPORT) 传播**——消费者侧
# 只看到真名 `OrangeEngine::orange_engine_imgui`。在 Config 阶段重建别名让
# in-tree / installed 两种语境下消费者都能按 `OrangeEngine::imgui` link
# （OrangeEditor / OrangeGames consumer 已按短名引用）。CMake 3.18+ 支持
# imported target 的 alias；项目要求 3.28+，满足。
if (TARGET OrangeEngine::orange_engine_imgui AND NOT TARGET OrangeEngine::imgui)
    add_library(OrangeEngine::imgui ALIAS OrangeEngine::orange_engine_imgui)
endif ()

# ---------------------------------------------------------------------------
# 内置 SPIR-V shader 路径 + 拷贝 helper（GAP-2026-05-27-builtin-shaders-not-
# installed-for-consumers）
#
# 引擎运行时按 ".exe 相对 shaders/orange_engine/*.spv" 加载内置 material /
# shadow / vfx / IBL shader。外部 find_package 消费者的 .exe 旁默认没有这些
# spv（它们装在 SDK 的 share/ 下），故提供：
#   * OrangeEngine_SHADER_DIR ——  已安装 spv 目录的绝对路径
#   * orange_engine_copy_builtin_shaders(<target>) —— 给消费者 exe target 挂
#     一个 POST_BUILD 步骤，把 spv 拷到 $<TARGET_FILE_DIR:target>/shaders/
#     orange_engine/，这样运行时相对路径就能命中。
#
# 典型用法（消费者 CMakeLists）：
#     add_executable(my_game ...)
#     target_link_libraries(my_game PRIVATE OrangeEngine::orange_engine)
#     orange_engine_copy_builtin_shaders(my_game)
# ---------------------------------------------------------------------------
set_and_check(OrangeEngine_SHADER_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/OrangeEngine/shaders/orange_engine")

function(orange_engine_copy_builtin_shaders target)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E make_directory
                "$<TARGET_FILE_DIR:${target}>/shaders/orange_engine"
        COMMAND "${CMAKE_COMMAND}" -E copy_directory
                "${OrangeEngine_SHADER_DIR}"
                "$<TARGET_FILE_DIR:${target}>/shaders/orange_engine"
        COMMENT "OrangeEngine: 拷贝内置 SPIR-V 到 ${target} 输出目录"
        VERBATIM)
endfunction()

check_required_components(OrangeEngine)
