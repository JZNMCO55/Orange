.vs/
.vscode/
out/
build/
# ASan / 别名 build 目录（如 build-asan/、build-tsan/）由调查 session
# 临时创建；构建产物不入库。
build-*/
script/__pycache__/
3rdparty/
install/

# Vulkan API dump / 临时 trace 文件（VK_LAYER_LUNARG_api_dump 输出 +
# 临时崩点 dump 等）落 project root 时不入库。
/api_*.txt

# install/ 的 ignore 用于挡住临时 install 输出，但 tests/install/
# 是 install_smoke / config_smoke 的源码目录，必须跟踪。
!tests/install/
!tests/install/**

# `vendor/` itself is tracked (each subentry is a git submodule registered in
# `.gitmodules`). Build artifacts inside vendored sub-repos are ignored by
# the sub-repo's own .gitignore, so we don't repeat them here.
memory/
screenshots/
vendor/LumixEngine/
vendor/cocos-engine/
vendor/godot/

# ImGui 运行时 dock layout 状态文件（编辑器 / sample 在 cwd 落盘）
imgui.ini

# Claude Code 本地调度 / 会话状态（scheduled_tasks.lock 等），纯机器本地，不入库
.claude/

# HDR 环境贴图：5 MB 量级二进制，由测试人员按 assets/environments/README.md
# 步骤从 PolyHaven 下载到本地，不进 git 仓主线避免 hot path 历史膨胀。
# 真正生产期由 Phase 9 资产管线把 .hdr → ORTX 容器化后再决定入库策略。
assets/environments/*.hdr
assets/environments/*.HDR

# v0.8 c1 EditorSettings 系统：编辑器关闭时把 gizmo / keybinding 用户配置落
# 仓库根目录，与开发者机器状态绑定（每人 keybinding 习惯不同），不入库。
editor_settings.json

# Pipeline::RequestCapture 调试截图：仅本地调试 ACES tonemap / HDR pipeline
# 时手动触发输出，每次内容随当时帧不同，不入库。
/hdr_capture.png

# v0.6 SaveSplit 落盘产物：从 assets/scenes/*.scene.json 派生的 per-layer
# 分文件 + manifest，每次 Save 都会重落，入库会产生持续 diff 噪音。需要
# 时由编辑器从 demo.scene.json 重新生成。
assets/scenes/splits/
